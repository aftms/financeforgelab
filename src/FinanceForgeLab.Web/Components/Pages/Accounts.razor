@page "/contas"
@inject FinanceService Service
<PageTitle>Contas · FinanceForgeLab</PageTitle>
<div class="page-heading"><div><span class="eyebrow">O PONTO DE PARTIDA</span><h1>As tuas contas</h1><p>Um saldo conhecido hoje, um histórico mais claro amanhã.</p></div><button class="button primary" @onclick="()=>editor=new()">+ Adicionar conta</button></div>
@if(message is not null){<div role="status" class="notice @(error?"error":"success")">@message</div>}
@if(editor is not null){<section class="panel editor-panel"><div class="panel-heading"><div><h2>@(editor.Id==0?"Adicionar conta":"Editar conta")</h2><p>O saldo de abertura representa o valor conhecido no início da data escolhida.</p></div><button type="button" class="icon-button" aria-label="Fechar formulário" @onclick="()=>editor=null">×</button></div>
<EditForm Model="editor" OnValidSubmit="Save" FormName="account"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid"><label>Nome<InputText @bind-Value="editor.Name" placeholder="Ex.: Conta do dia a dia"/></label><label>Tipo<InputSelect @bind-Value="editor.Type"><option value="Bank">Conta bancária</option><option value="Savings">Poupança</option><option value="Cash">Dinheiro</option><option value="Other">Outra</option></InputSelect></label>
@if(editor.Id==0){<label>Data inicial do saldo<InputDate @bind-Value="editor.BalanceStartDate"/></label><label>Saldo de abertura em EUR<InputNumber @bind-Value="editor.OpeningBalance" step="0.0001"/></label>}else{<div class="form-note">Data inicial: @editor.BalanceStartDate.ToString("dd/MM/yyyy"). Alterações da abertura requerem reconciliação.</div>}
<label class="checkbox-label"><InputCheckbox @bind-Value="editor.Active"/> Conta ativa</label></div><div class="form-footer"><span class="hint">Movimentos anteriores à abertura permanecem consultáveis e não são somados novamente.</span><button class="button" type="button" @onclick="()=>editor=null">Cancelar</button><button class="button primary" type="submit" disabled="@busy">Guardar conta</button></div></EditForm></section>}
@if(accounts.Count==0){<section class="empty-state panel"><span class="empty-icon">▤</span><h2>A tua primeira conta começa aqui.</h2><p>O histórico já está disponível. Adiciona uma conta e indica um saldo inicial conhecido para começares a acompanhar os saldos.</p><button class="button primary" @onclick="()=>editor=new()">Adicionar primeira conta</button></section>}
else{<div class="accounts-grid">@foreach(var a in accounts){<article class="panel account-card @(a.Account.Active?"":"inactive")"><div class="account-top"><span class="account-symbol">▤</span><span class="badge @(a.Account.Active?"income":"neutral")">@(a.Account.Active?"Ativa":"Inativa")</span></div><h2>@a.Account.Name</h2><p class="muted">@AccountType(a.Account.Type) · @a.Account.Currency</p><strong class="account-balance">@Format.Money(a.BalanceUnits)</strong><p class="hint">A partir de @a.Account.BalanceStartDate?.ToString("dd/MM/yyyy")</p>@if(a.HistoricalBeforeOpening>0){<p class="hint">@a.HistoricalBeforeOpening movimentos anteriores à abertura fora deste saldo.</p>}<div class="account-actions"><a href="@("/movimentos?conta="+a.Account.Id)" class="text-link">Ver movimentos →</a><button class="button" @onclick="()=>Edit(a.Account)">Editar</button></div></article>}</div>}
<div class="notice"><div><strong>Associar o histórico, ao teu ritmo.</strong><p>Os movimentos migrados não têm conta bancária identificada. Associa-os no ecrã de movimentos apenas quando souberes a conta correta.</p></div><a href="/movimentos?porAssociar=true">Consultar histórico →</a></div>
@code{
    List<AccountSummary> accounts=[];AccountForm? editor;string? message;bool busy,error;
    protected override async Task OnInitializedAsync()=>accounts=await Service.AccountsAsync();
    static string AccountType(string type)=>type switch{"Cash"=>"Dinheiro","Savings"=>"Poupança","Other"=>"Outra",_=>"Conta bancária"};
    void Edit(Account a)=>editor=new(){Id=a.Id,Version=a.Version,Name=a.Name,Type=a.Type,Active=a.Active,BalanceStartDate=a.BalanceStartDate??DateOnly.FromDateTime(DateTime.Today)};
    async Task Save(){if(busy)return;busy=true;error=false;message=null;try{await Service.SaveAccountAsync(editor!);editor=null;accounts=await Service.AccountsAsync();message="Conta guardada.";}catch(FinanceRuleException e){error=true;message=e.Message;}catch(Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException){error=true;message="A conta foi alterada. Volta a abri-la.";}finally{busy=false;}}
}
