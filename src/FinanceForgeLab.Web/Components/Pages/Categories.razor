@page "/categorias"
@inject FinanceService Service
<PageTitle>Categorias · FinanceForgeLab</PageTitle>
<div class="page-heading"><div><span class="eyebrow">CADA COISA NO SEU LUGAR</span><h1>Categorias</h1><p>Uma organização que acompanha a tua vida.</p></div><button class="button primary" @onclick="()=>editor=new()">+ Nova categoria</button></div>
@if(message is not null){<div role="status" class="notice @(error?"error":"success")">@message</div>}
@if(editor is { } form){<section class="panel editor-panel"><div class="panel-heading"><div><h2>@(form.Id==0?"Nova categoria":"Editar categoria")</h2><p>Desativar preserva todos os movimentos e classificações existentes.</p></div><button type="button" class="icon-button" aria-label="Fechar formulário" @onclick="()=>editor=null">×</button></div><EditForm Model="form" OnValidSubmit="Save" FormName="category"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid"><label>Nome<InputText @bind-Value="form.Name"/></label><label>Tipo<InputSelect @bind-Value="form.Kind"><option value="@MovementKind.Income">Receita</option><option value="@MovementKind.Expense">Despesa</option></InputSelect></label><label>Categoria de raiz<InputSelect @bind-Value="form.ParentId"><option value="">Esta é uma categoria de raiz</option>@foreach(var p in categories.Where(c=>c.ParentId is null&&c.Kind==form.Kind&&c.Id!=form.Id&&c.Active)){<option value="@p.Id">@p.Name</option>}</InputSelect></label><label class="checkbox-label"><InputCheckbox @bind-Value="form.Active"/> Ativa</label></div><div class="form-footer"><span class="hint">Categorias utilizadas conservam o seu tipo e hierarquia.</span><button class="button" type="button" @onclick="()=>editor=null">Cancelar</button><button class="button primary" type="submit" disabled="@busy">Guardar categoria</button></div></EditForm></section>}
<section class="panel"><div class="panel-heading"><div><h2>A tua organização</h2><p>@categories.Count(c=>c.ParentId is null) categorias · @categories.Count(c=>c.ParentId is not null) subcategorias</p></div><label><span class="sr-only">Pesquisar categorias</span><input placeholder="Pesquisar categoria…" @bind="search" @bind:event="oninput"/></label></div><div class="category-list">@foreach(var root in categories.Where(c=>c.ParentId is null).OrderBy(c=>c.Kind).ThenBy(c=>c.Name)){var children=categories.Where(c=>c.ParentId==root.Id).OrderBy(c=>c.Name).ToList();if(!Matches(root)&&!children.Any(Matches))continue;<div class="category-group"><div class="category-root"><div><span class="category-symbol">◇</span><strong>@root.Name</strong><span class="badge @(root.Kind==MovementKind.Income?"income":"expense")">@Format.Kind(root.Kind)</span>@if(!root.Active){<span class="badge neutral">Inativa</span>}</div><button class="button small" @onclick="()=>Edit(root)">Editar</button></div><div class="subcategory-list">@foreach(var sub in children.Where(c=>string.IsNullOrWhiteSpace(search)||Matches(c)||Matches(root))){<button class="subcategory @(sub.Active?"":"inactive")" title="Editar subcategoria" @onclick="()=>Edit(sub)">@sub.Name @if(!sub.Active){<span> · Inativa</span>}<span class="edit-mark">↗</span></button>}</div></div>}</div></section>
@code{
    List<Category> categories=[];CategoryForm? editor;string search="";string? message;bool error,busy;
    protected override async Task OnInitializedAsync()=>categories=await Service.CategoriesAsync();
    bool Matches(Category c)=>string.IsNullOrWhiteSpace(search)||c.Name.Contains(search,StringComparison.CurrentCultureIgnoreCase);
    void Edit(Category c)=>editor=new(){Id=c.Id,Version=c.Version,Name=c.Name,Kind=c.Kind,ParentId=c.ParentId,Active=c.Active};
    async Task Save(){if(busy)return;busy=true;error=false;message=null;try{await Service.SaveCategoryAsync(editor!);editor=null;categories=await Service.CategoriesAsync();message="Categoria guardada.";}catch(FinanceRuleException e){error=true;message=e.Message;}catch(Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException){error=true;message="A categoria foi alterada. Volta a abri-la.";}finally{busy=false;}}
}
