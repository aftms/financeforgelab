@page "/"
@inject FinanceService Service
<PageTitle>Visão geral · FinanceForgeLab</PageTitle>
<div class="page-heading"><div><span class="eyebrow">O TEU DINHEIRO, NUM SÓ LUGAR</span><h1>Visão geral</h1><p>Uma perspetiva clara das tuas finanças.</p></div><div class="heading-actions"><label class="sr-only" for="year">Ano</label><select id="year" value="@summary?.Year" @onchange="ChangeYear">@if(summary is not null){foreach(var year in summary.Years){<option value="@year">@year</option>}}</select><a href="/movimentos?novo=true" class="button primary">+ Novo movimento</a></div></div>
@if(summary is null){<div class="loading" role="status">A preparar a tua visão geral…</div>}
else
{
    @if(summary.UnassignedCount > 0){<div class="notice historic"><span class="notice-symbol">↗</span><div><strong>O teu histórico está preservado.</strong><p>@summary.UnassignedCount.ToString("N0") movimentos ainda sem conta associada. Podes consultá-los e associá-los progressivamente.</p></div><a href="/movimentos?porAssociar=true">Ver histórico →</a></div>}
    <div class="stat-grid"><article class="stat-card dark"><div class="stat-label">Saldo das contas <span>▤</span></div><strong>@(summary.Accounts.Count == 0 ? "Por configurar" : Format.Money(summary.Accounts.Where(x=>x.Account.Active).Sum(x=>x.BalanceUnits)))</strong><p>@(summary.Accounts.Count == 0 ? "Adiciona uma conta para acompanhar o saldo." : "Contas ativas · EUR")</p><a href="/contas">Gerir contas <span>→</span></a></article>
    <article class="stat-card"><div class="stat-label">Receitas de @summary.Year <span class="mini-icon income">↙</span></div><strong>@Format.Money(summary.IncomeUnits)</strong><p>Entradas líquidas do período</p><span class="subtle-line income-line"></span></article>
    <article class="stat-card"><div class="stat-label">Despesas de @summary.Year <span class="mini-icon expense">↗</span></div><strong>@Format.Money(summary.ExpenseUnits)</strong><p>Saídas líquidas do período</p><span class="subtle-line expense-line"></span></article>
    <article class="stat-card"><div class="stat-label">Resultado do período <span class="mini-icon">≈</span></div><strong class="@(summary.IncomeUnits-summary.ExpenseUnits>=0 ? "positive":"negative")">@Format.Money(summary.IncomeUnits-summary.ExpenseUnits)</strong><p>Receitas menos despesas</p><span class="badge neutral">@summary.Count.ToString("N0") movimentos</span></article></div>
    <div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><h2>Ao longo do ano</h2><p>Receitas e despesas mensais · @summary.Year</p></div><div class="legend"><span><i class="income-dot"></i> Receitas</span><span><i class="expense-dot"></i> Despesas</span></div></div>
        <div class="chart-top">@Format.Money(MaxUnits)</div><div class="monthly-chart" role="img" aria-label="Receitas e despesas mensais. Os valores de cada mês estão disponíveis na legenda das barras.">
        @foreach(var m in summary.Months){<div class="month-column" title="@(Format.Month(m.Month)+": receitas "+Format.Money(m.IncomeUnits)+", despesas "+Format.Money(m.ExpenseUnits))"><div class="bar-pair"><div class="bar income-bar" style="height:@Percent(m.IncomeUnits)%"></div><div class="bar expense-bar" style="height:@Percent(m.ExpenseUnits)%"></div></div><span>@Format.Month(m.Month)</span><span class="sr-only">@Format.Money(m.IncomeUnits) / @Format.Money(m.ExpenseUnits)</span></div>}
        </div><p class="hint chart-note">Meses sem registos não confirmam ausência de movimentos. Transferências e aberturas ficam fora destes totais.</p></section>
        <section class="panel"><div class="panel-heading"><div><h2>Para onde foi o dinheiro</h2><p>Principais categorias de despesa</p></div><span class="small-icon">◇</span></div><div class="category-bars">@foreach(var c in summary.Expenses){<div class="category-bar"><div><span>@c.Name</span><strong>@Format.Money(c.Units)</strong></div><div class="progress-track"><span style="width:@CategoryPercent(c.Units)%"></span></div></div>}@if(summary.Expenses.Count==0){<p class="empty-small">Ainda não há despesas neste período.</p>}</div></section></div>
    <section class="panel recent-panel"><div class="panel-heading"><div><h2>Últimos movimentos</h2><p>Os registos mais recentes de @summary.Year</p></div><a href="/movimentos" class="text-link">Ver todos →</a></div><div class="table-wrap"><table><thead><tr><th>Data</th><th>Descrição</th><th>Categoria</th><th>Conta</th><th class="align-right">Montante</th></tr></thead><tbody>@foreach(var r in recent){<tr><td class="date-cell">@r.Date.ToString("dd MMM yyyy")</td><td><span class="transaction-icon @(r.Kind==MovementKind.Income?"income":"expense")">@(r.Kind==MovementKind.Income?"↙":"↗")</span><strong>@(string.IsNullOrWhiteSpace(r.Description)?"Sem descrição":r.Description)</strong></td><td><span class="badge neutral">@(r.ParentCategory??r.Category??Format.Kind(r.Kind))</span></td><td class="muted">@(r.Account??"Por associar")</td><td class="align-right amount @(r.Units>=0?"positive":"")">@Format.Money(r.Units)</td></tr>}</tbody></table></div></section>
}
@code{
    DashboardSummary? summary; List<MovementRow> recent=[];
    long MaxUnits=>Math.Max(1,summary?.Months.Max(x=>Math.Max(Math.Abs(x.IncomeUnits),Math.Abs(x.ExpenseUnits)))??1);
    int Percent(long value)=>(int)Math.Clamp(Math.Abs((decimal)value)/MaxUnits*100,0,100);
    int CategoryPercent(long value)=>(int)Math.Clamp((decimal)value/Math.Max(1,summary?.Expenses.FirstOrDefault()?.Units??1)*100,0,100);
    protected override async Task OnInitializedAsync()=>await Load(null);
    async Task Load(int? year){summary=await Service.DashboardAsync(year);recent=(await Service.MovementsAsync(new(){From=new(summary.Year,1,1),To=new(summary.Year,12,31),PageSize=10})).Rows.Take(6).ToList();}
    async Task ChangeYear(ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var year))await Load(year);}
}
