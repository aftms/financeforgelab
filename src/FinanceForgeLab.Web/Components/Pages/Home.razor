@page "/"
@inject FinanceService Service
<PageTitle>Visão geral · FinanceForgeLab</PageTitle>
<div class="page-heading"><div><span class="eyebrow">O TEU DINHEIRO, NUM SÓ LUGAR</span><h1>Visão geral</h1><p>Uma perspetiva clara das tuas finanças.</p></div><div class="heading-actions"><label class="sr-only" for="year">Ano</label><select id="year" value="@summary?.Year" @onchange="ChangeYear">@if(summary is not null){foreach(var year in summary.Years){<option value="@year">@year</option>}}</select><a href="/movimentos?novo=true" class="button primary">+ Novo movimento</a></div></div>
@if(summary is null){<div class="loading" role="status">A preparar a tua visão geral…</div>}
else
{
    <div class="stat-grid">
    <article class="stat-card dark"><div class="stat-label">Despesas de @summary.Year <span>↗</span></div><strong>@Format.Money(summary.ExpenseUnits)</strong><p>Despesas registadas no período</p><a href="@MovementsUrl(MovementKind.Expense)">Consultar despesas <span>→</span></a></article>
    <article class="stat-card"><div class="stat-label">Receitas de @summary.Year <span class="mini-icon income">↙</span></div><strong>@Format.Money(summary.IncomeUnits)</strong><p>Receitas registadas no período</p><a href="@MovementsUrl(MovementKind.Income)">Consultar receitas →</a></article>
    <article class="stat-card"><div class="stat-label">Resultado do período <span class="mini-icon">≈</span></div><strong class="@(summary.IncomeUnits-summary.ExpenseUnits>=0 ? "positive":"negative")">@Format.Money(summary.IncomeUnits-summary.ExpenseUnits)</strong><p>Receitas menos despesas</p></article>
    <article class="stat-card"><div class="stat-label">Registos de @summary.Year <span>⇄</span></div><strong>@summary.Count.ToString("N0")</strong><p>Despesas e receitas registadas</p><a href="/extratos">Importar de um extrato →</a></article></div>
    <div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><h2>Ao longo do ano</h2><p>Receitas e despesas mensais · @summary.Year</p></div><div class="legend"><span><i class="income-dot"></i> Receitas</span><span><i class="expense-dot"></i> Despesas</span></div></div>
        <div class="chart-top">@Format.Money(MaxUnits)</div><div class="monthly-chart" role="group" aria-label="Receitas e despesas mensais. Seleciona uma barra para consultar os movimentos.">
        @foreach(var m in summary.Months){<div class="month-column"><div class="bar-pair">
            @if(m.IncomeUnits!=0){<a class="bar income-bar" style="height:@Percent(m.IncomeUnits)%" href="@MonthMovementsUrl(m.Month,MovementKind.Income)" aria-label="@BarLabel(m.Month,MovementKind.Income,m.IncomeUnits)" title="@BarLabel(m.Month,MovementKind.Income,m.IncomeUnits)"></a>}else{<div class="bar income-bar" style="height:0" aria-hidden="true"></div>}
            @if(m.ExpenseUnits!=0){<a class="bar expense-bar" style="height:@Percent(m.ExpenseUnits)%" href="@MonthMovementsUrl(m.Month,MovementKind.Expense)" aria-label="@BarLabel(m.Month,MovementKind.Expense,m.ExpenseUnits)" title="@BarLabel(m.Month,MovementKind.Expense,m.ExpenseUnits)"></a>}else{<div class="bar expense-bar" style="height:0" aria-hidden="true"></div>}
            </div><span>@Format.Month(m.Month)</span><span class="sr-only">@Format.Money(m.IncomeUnits) / @Format.Money(m.ExpenseUnits)</span></div>}
        </div><p class="hint chart-note">Meses sem registos não confirmam ausência de movimentos. Transferências e aberturas ficam fora destes totais.</p></section>
        <section class="panel"><div class="panel-heading"><div><h2>Para onde foi o dinheiro</h2><p>Todas as categorias de despesa · @summary.Year</p></div><span class="small-icon">◇</span></div><div class="category-bars">@foreach(var c in summary.Expenses){<a class="category-bar" href="@(MovementsUrl(MovementKind.Expense)+$"&categoria={c.CategoryId??0}")" aria-label="@($"Consultar movimentos de {c.Name} em {summary.Year}")"><div><span>@c.Name</span><strong>@Format.Money(c.Units)</strong></div><div class="progress-track"><span style="width:@CategoryPercent(c.Units)%"></span></div></a>}@if(summary.Expenses.Count==0){<p class="empty-small">Ainda não há despesas neste período.</p>}</div></section></div>
    <section class="panel recent-panel"><div class="panel-heading"><div><h2>Últimos registos</h2><p>Os registos mais recentes de @summary.Year</p></div><a href="/movimentos" class="text-link">Ver todos →</a></div><div class="table-wrap"><table><thead><tr><th>Data</th><th>Descrição / detalhe</th><th>Categoria / subcategoria</th><th>Pessoa</th><th class="align-right">Montante</th></tr></thead><tbody>@foreach(var r in recent){<tr><td class="date-cell">@r.Date.ToString("dd MMM yyyy")</td><td><span class="transaction-icon @(r.Kind==MovementKind.Income?"income":"expense")">@(r.Kind==MovementKind.Income?"↙":"↗")</span><MovementDetail Row="r"/></td><td class="movement-classification"><span class="badge neutral">@(r.ParentCategory??r.Category??Format.Kind(r.Kind))</span>@if(r.ParentCategory is not null){<strong class="movement-subcategory">@r.Category</strong>}</td><td class="muted">@(r.Person??"—")</td><td class="align-right amount @(r.Units>=0?"positive":"")">@Format.Money(r.Units)</td></tr>}</tbody></table></div></section>
}
@code{
    DashboardSummary? summary; List<MovementRow> recent=[];
    string MovementsUrl(MovementKind? kind=null)=>$"/movimentos?ano={summary!.Year}"+(kind is {} k?$"&tipo={k}":"");
    string MonthMovementsUrl(int month,MovementKind kind)=>MovementsUrl(kind)+$"&mes={month}";
    string BarLabel(int month,MovementKind kind,long units)=>$"Consultar {(kind==MovementKind.Income?"receitas":"despesas")} de {new DateTime(summary!.Year,month,1).ToString("MMMM yyyy",System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))}: {Format.Money(units)}";
    long MaxUnits=>Math.Max(1,summary?.Months.Max(x=>Math.Max(Math.Abs(x.IncomeUnits),Math.Abs(x.ExpenseUnits)))??1);
    int Percent(long value)=>(int)Math.Clamp(Math.Abs((decimal)value)/MaxUnits*100,0,100);
    int CategoryPercent(long value)=>(int)Math.Clamp((decimal)value/Math.Max(1,summary?.Expenses.FirstOrDefault()?.Units??1)*100,0,100);
    protected override async Task OnInitializedAsync()=>await Load(null);
    async Task Load(int? year){summary=await Service.DashboardAsync(year);recent=(await Service.MovementsAsync(new(){From=new(summary.Year,1,1),To=new(summary.Year,12,31),PageSize=10})).Rows.Take(6).ToList();}
    async Task ChangeYear(ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var year))await Load(year);}
}
