@page "/movimentos"
@implements IDisposable
@inject FinanceService Service
<PageTitle>Movimentos · FinanceForgeLab</PageTitle>
<div class="page-heading"><div><span class="eyebrow">CADA REGISTO CONTA</span><h1>Movimentos</h1><p>Consulta o histórico e organiza as entradas e saídas.</p></div><div class="heading-actions"><a class="button" href="@ExportUrl" download>↓ Exportar CSV</a><button class="button primary" @onclick="New">+ Novo movimento</button></div></div>
@if(message is not null){<div role="status" class="notice @(error?"error":"success")">@message</div>}
@if(appliedFilter.TransactionId is {} selectedTransaction){<p class="notice">A mostrar os registos associados ao pagamento #@selectedTransaction. <a href="/movimentos">Consultar todos os movimentos →</a></p>}
<section class="panel filter-panel movement-filters" aria-label="Filtros de movimentos">
    <div class="movement-period">
        <label class="search-field">Pesquisar<input placeholder="Descrição ou observações…" @bind="filter.Search" @bind:event="oninput" @bind:after="SearchChanged"/></label>
        <label>Período<select @bind="period.Mode" @bind:after="Apply"><option value="@MovementPeriodMode.Month">Mês / ano</option><option value="@MovementPeriodMode.Dates">Intervalo de datas</option><option value="@MovementPeriodMode.All">Todo o histórico</option></select></label>
        @if(period.Mode==MovementPeriodMode.Month){<label class="period-year">Ano<select @bind="period.Year" @bind:after="Apply">@foreach(var year in years.Append(period.Year).Append(MovementPeriod.TodayInLisbon.Year).Distinct().OrderDescending()){<option value="@year">@year</option>}</select></label><label>Mês<select @bind="period.Month" @bind:after="Apply"><option value="0">Ano completo</option>@for(var month=1;month<=12;month++){<option value="@month">@MonthName(month)</option>}</select></label>}
        else if(period.Mode==MovementPeriodMode.Dates){<label>Data inicial<input type="date" @bind="period.From" @bind:after="Apply"/></label><label>Data final<input type="date" @bind="period.To" @bind:after="Apply"/></label>}
        <button type="button" class="button ghost" disabled="@busy" @onclick="CurrentMonth">Mês atual</button>
        <button class="button ghost" disabled="@busy" @onclick="Clear">Limpar</button>
    </div>
    <div class="filter-grid"><label>Conta<select @bind="filter.AccountId" @bind:after="Apply"><option value="">Todas as contas</option><option value="-1">Por associar</option>@foreach(var a in accounts){<option value="@a.Account.Id">@a.Account.Name</option>}</select></label><label>Categoria<select @bind="filter.CategoryId" @bind:after="Apply"><option value="">Todas as categorias</option><option value="0">Por classificar — todas as categorias</option>@foreach(var c in categories){<option value="@c.Id">@CategoryName(c)</option>}</select></label><label>Tipo<select @bind="filter.Kind" @bind:after="Apply"><option value="">Todos</option><option value="@MovementKind.Income">Receitas</option><option value="@MovementKind.Expense">Despesas</option><option value="@MovementKind.Transfer">Transferências</option></select></label><label>Pessoa<select @bind="filter.PersonId" @bind:after="Apply"><option value="">Todas</option>@foreach(var p in people){<option value="@p.Id">@p.Name</option>}</select></label><div class="filter-actions"><label class="checkbox-label"><input type="checkbox" @bind="filter.IncludeVoided" @bind:after="Apply"/> Incluir anulados</label></div></div>
</section>
@if(pendingVoid is not null){<div class="notice warning"><div><strong>Anular este movimento?</strong><p>@pendingVoid.DisplayDescription · @Format.Money(pendingVoid.Units). Só este movimento será anulado e mantém-se no histórico. Se for uma transferência, são afetadas as suas duas contas.</p></div><button class="button danger" @onclick="ConfirmVoid" disabled="@busy">Confirmar anulação</button><button class="button" @onclick="()=>pendingVoid=null">Cancelar</button></div>}
@if(editor is { } form){<EditorPanel Class="movement-editor" Label="Formulário de movimento" @key="form"><div class="panel-heading"><div><h2>@(form.Id==0?"Novo movimento":"Editar movimento")</h2><p>Os valores negativos representam estornos ou correções.</p></div><button type="button" class="icon-button" aria-label="Fechar formulário" @onclick="()=>editor=null">×</button></div>
@if(accounts.Count==0&&form.Id==0){<div class="notice"><p>Adiciona a tua primeira conta para registar movimentos novos.</p><a href="/contas">Adicionar conta →</a></div>}
<EditForm Model="form" OnValidSubmit="Save" FormName="movement"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid"><label>Tipo<InputSelect @bind-Value="form.Kind" @bind-Value:after="EditorKindChanged"><option value="@MovementKind.Income">Receita</option><option value="@MovementKind.Expense">Despesa</option><option value="@MovementKind.Transfer">Transferência</option></InputSelect></label><label>Data<InputDate @bind-Value="form.Date"/></label><label>Montante em EUR<InputNumber @bind-Value="form.Amount" step="0.0001"/></label><label>Conta de origem<InputSelect @bind-Value="form.AccountId"><option value="">Por associar</option>@foreach(var a in accounts){<option value="@a.Account.Id">@a.Account.Name @(a.Account.Active?"":"(inativa)")</option>}</InputSelect></label>
@if(form.Kind==MovementKind.Transfer){<label>Conta de destino<InputSelect @bind-Value="form.DestinationAccountId"><option value="">Selecionar conta</option>@foreach(var a in accounts){<option value="@a.Account.Id">@a.Account.Name</option>}</InputSelect></label>}else{<div class="movement-category-fields"><CategoryPicker Categories="categories" Kind="form.Kind" @bind-Value="form.CategoryId" PreserveInactiveSelection="true" Disabled="busy" Context="do movimento"/></div>}
<label>Pessoa<InputSelect @bind-Value="form.PersonId"><option value="">Sem pessoa associada</option>@foreach(var p in people){<option value="@p.Id">@p.Name</option>}</InputSelect></label><label class="movement-description">Descrição<InputText @bind-Value="form.Description"/></label><label class="movement-notes-field">Observações<InputTextArea @bind-Value="form.Notes" rows="1"/></label></div><div class="form-footer"><span class="hint">Até quatro casas decimais. Sem arredondamento automático.</span><button type="button" class="button" @onclick="()=>editor=null">Cancelar</button><button class="button primary" type="submit" disabled="@busy">@(busy?"A guardar…":"Guardar movimento")</button></div></EditForm></EditorPanel>}
<section class="panel movement-records"><div class="panel-heading"><div><h2>Registos financeiros</h2><p>@(page?.Total.ToString("N0")??"…") registos encontrados <span class="movement-period-label">· @PeriodLabel</span></p></div><span class="badge neutral">EUR</span></div><div class="table-wrap" role="region" aria-label="Lista de movimentos" tabindex="0"><table><thead><tr><th scope="col" aria-sort="@SortAria(MovementSort.Date)"><button type="button" class="sort-heading" disabled="@busy" @onclick="()=>SortBy(MovementSort.Date)" title="@SortTitle(MovementSort.Date, "Data")">Data<span aria-hidden="true">@SortIcon(MovementSort.Date)</span></button></th><th scope="col" aria-sort="@SortAria(MovementSort.Description)"><button type="button" class="sort-heading" disabled="@busy" @onclick="()=>SortBy(MovementSort.Description)" title="@SortTitle(MovementSort.Description, "Descrição / detalhe / pessoa")">Descrição / detalhe / pessoa<span aria-hidden="true">@SortIcon(MovementSort.Description)</span></button></th><th scope="col" aria-sort="@SortAria(MovementSort.Category)"><button type="button" class="sort-heading" disabled="@busy" @onclick="()=>SortBy(MovementSort.Category)" title="@SortTitle(MovementSort.Category, "Categoria / subcategoria")">Categoria / subcategoria<span aria-hidden="true">@SortIcon(MovementSort.Category)</span></button></th><th scope="col" aria-sort="@SortAria(MovementSort.Account)"><button type="button" class="sort-heading" disabled="@busy" @onclick="()=>SortBy(MovementSort.Account)" title="@SortTitle(MovementSort.Account, "Conta")">Conta<span aria-hidden="true">@SortIcon(MovementSort.Account)</span></button></th><th scope="col" aria-sort="@SortAria(MovementSort.Kind)"><button type="button" class="sort-heading" disabled="@busy" @onclick="()=>SortBy(MovementSort.Kind)" title="@SortTitle(MovementSort.Kind, "Tipo")">Tipo<span aria-hidden="true">@SortIcon(MovementSort.Kind)</span></button></th><th scope="col" class="align-right" aria-sort="@SortAria(MovementSort.Amount)"><button type="button" class="sort-heading" disabled="@busy" @onclick="()=>SortBy(MovementSort.Amount)" title="@SortTitle(MovementSort.Amount, "Montante")">Montante<span aria-hidden="true">@SortIcon(MovementSort.Amount)</span></button></th><th scope="col"><span class="sr-only">Ações</span></th></tr></thead><tbody>
@if(page is not null){foreach(var r in page.Rows){<tr @key="r.EntryKey" class="@(r.Status=="Voided"?"voided":"")"><td class="date-cell">@r.Date.ToString("dd/MM/yyyy")</td><td><MovementDetail Row="r"/><small>@(r.Person??"—") @(r.Origin=="Legacy"?" · Histórico":"")</small></td><td>@(r.ParentCategory??r.Category??"—")<small>@(r.ParentCategory is not null?r.Category:"")</small></td><td>@(r.Account??"Por associar")</td><td><span class="badge @(r.Status=="Voided"?"neutral":r.Kind==MovementKind.Income?"income":r.Kind==MovementKind.Expense?"expense":"neutral")">@(r.Status=="Voided"?"Anulado":Format.Kind(r.Kind))</span></td><td class="align-right amount @(r.Units>0?"positive":"")">@Format.Money(r.Units)</td><td class="row-actions">@if(r.Status=="Confirmed"&&r.Kind is MovementKind.Income or MovementKind.Expense or MovementKind.Transfer){<button title="Editar movimento" aria-label="Editar movimento" @onclick="()=>Edit(r)" disabled="@busy">Editar</button><button class="danger-text" title="Anular movimento" @onclick="()=>pendingVoid=r" disabled="@busy">Anular</button>}</td></tr>}if(page.Rows.Count==0){<tr><td colspan="7" class="empty-small">Nenhum movimento corresponde a estes filtros.</td></tr>}}
</tbody></table></div><div class="pagination"><span>Página @(page?.Page??1) de @TotalPages</span><div><button class="button" disabled="@(busy||(page?.Page??1)<=1)" @onclick="Previous">← Anterior</button><button class="button" disabled="@(busy||(page?.Page??1)>=TotalPages)" @onclick="Next">Seguinte →</button></div></div></section>
<BusyIndicator Active="busy" />
@code {
    [SupplyParameterFromQuery(Name="novo")]public bool NewRequested{get;set;}
    [SupplyParameterFromQuery(Name="porAssociar")]public bool UnassignedRequested{get;set;}
    [SupplyParameterFromQuery(Name="conta")]public long? AccountRequested{get;set;}
    [SupplyParameterFromQuery(Name="categoria")]public long? CategoryRequested{get;set;}
    [SupplyParameterFromQuery(Name="periodo")]public string? PeriodRequested{get;set;}
    [SupplyParameterFromQuery(Name="ano")]public int? YearRequested{get;set;}
    [SupplyParameterFromQuery(Name="mes")]public int? MonthRequested{get;set;}
    [SupplyParameterFromQuery(Name="tipo")]public string? KindRequested{get;set;}
    [SupplyParameterFromQuery(Name="registo")]public long? TransactionRequested{get;set;}
    MovementFilter filter=new(),appliedFilter=new();MovementPeriod period=new(MovementPeriod.TodayInLisbon);MovementPage? page;MovementForm? editor;MovementRow? pendingVoid;List<AccountSummary> accounts=[];List<Category> categories=[];List<Person> people=[];List<int> years=[];string? message;bool error,busy;
    int TotalPages=>Math.Max(1,(int)Math.Ceiling((page?.Total??0)/(double)(page?.PageSize??40)));
    string CategoryName(Category c)=>(c.ParentId is null?"":categories.FirstOrDefault(p=>p.Id==c.ParentId)?.Name+" / ")+c.Name;
    string ExportUrl=>"/api/v1/export.csv?transactionId="+appliedFilter.TransactionId+"&"+string.Join("&",new Dictionary<string,string?>{{"from",appliedFilter.From?.ToString("yyyy-MM-dd")},{"to",appliedFilter.To?.ToString("yyyy-MM-dd")},{"accountId",appliedFilter.AccountId?.ToString()},{"categoryId",appliedFilter.CategoryId?.ToString()},{"personId",appliedFilter.PersonId?.ToString()},{"kind",appliedFilter.Kind?.ToString()},{"search",appliedFilter.Search},{"includeVoided",appliedFilter.IncludeVoided.ToString()},{"sort",appliedFilter.Sort.ToString()},{"descending",appliedFilter.Descending.ToString()}}.Where(x=>!string.IsNullOrEmpty(x.Value)).Select(x=>x.Key+"="+Uri.EscapeDataString(x.Value!)));
    string PeriodLabel=>appliedFilter.From is {} from&&appliedFilter.To is {} to?$"{from:dd/MM/yyyy} – {to:dd/MM/yyyy}":appliedFilter.From is {} start?$"Desde {start:dd/MM/yyyy}":appliedFilter.To is {} end?$"Até {end:dd/MM/yyyy}":"Todo o histórico";
    static string MonthName(int month)=>new DateTime(2000,month,1).ToString("MMMM",System.Globalization.CultureInfo.GetCultureInfo("pt-PT"));
    static MovementFilter CopyFilter(MovementFilter source)=>new(){TransactionId=source.TransactionId,From=source.From,To=source.To,AccountId=source.AccountId,CategoryId=source.CategoryId,PersonId=source.PersonId,Kind=source.Kind,Search=source.Search,IncludeVoided=source.IncludeVoided,Page=source.Page,PageSize=source.PageSize,Sort=source.Sort,Descending=source.Descending};
    protected override async Task OnInitializedAsync()
    {
        accounts=await Service.AccountsAsync();categories=await Service.CategoriesAsync();people=await Service.PeopleAsync();years=await Service.MovementYearsAsync();
        filter.AccountId=UnassignedRequested?-1:AccountRequested;filter.CategoryId=CategoryRequested;
        filter.TransactionId=TransactionRequested;
        if(PeriodRequested=="todos"||TransactionRequested is not null)period.Mode=MovementPeriodMode.All;
        else if(YearRequested is >=1 and <=9999){period.Year=YearRequested.Value;period.Month=MonthRequested is >=1 and <=12?MonthRequested.Value:0;}
        if(Enum.TryParse<MovementKind>(KindRequested,out var requestedKind)&&requestedKind is MovementKind.Income or MovementKind.Expense or MovementKind.Transfer)filter.Kind=requestedKind;
        (filter.From,filter.To)=period.Resolve();await Load(CopyFilter(filter));if(NewRequested)New();
    }
    async Task Load(MovementFilter requested){var loaded=await Service.MovementsAsync(requested);requested.Page=loaded.Page;appliedFilter=CopyFilter(requested);page=loaded;}
    CancellationTokenSource? searchDelay;bool filtersPending,disposed;
    void CancelSearch(){searchDelay?.Cancel();searchDelay?.Dispose();searchDelay=null;}
    async Task SearchChanged()
    {
        CancelSearch();var delay=searchDelay=new();
        try{await Task.Delay(350,delay.Token);if(!disposed)await Apply();}
        catch(OperationCanceledException){}
    }
    async Task Apply()
    {
        CancelSearch();if(disposed)return;
        if(busy){filtersPending=true;return;}
        await Run(async()=>{var requested=CopyFilter(filter);(requested.From,requested.To)=period.Resolve();requested.Page=1;await Load(requested);});
    }
    string? SortAria(MovementSort column)=>appliedFilter.Sort==column?(appliedFilter.Descending?"descending":"ascending"):null;
    string SortIcon(MovementSort column)=>appliedFilter.Sort==column?(appliedFilter.Descending?"↓":"↑"):"↕";
    string SortTitle(MovementSort column,string label)=>$"Ordenar por {label}: {(appliedFilter.Sort==column&&!appliedFilter.Descending?"decrescente":"crescente")}";
    async Task SortBy(MovementSort column)=>await Run(async()=>{
        var requested=CopyFilter(appliedFilter);requested.Sort=column;
        requested.Descending=appliedFilter.Sort==column&&!appliedFilter.Descending;requested.Page=1;
        await Load(requested);filter.Sort=appliedFilter.Sort;filter.Descending=appliedFilter.Descending;
    });
    async Task CurrentMonth(){period=new(MovementPeriod.TodayInLisbon);await Apply();}
    async Task Clear(){filter=new();period=new(MovementPeriod.TodayInLisbon);await Apply();}
    void New(){editor=new(){Date=MovementPeriod.TodayInLisbon,CategoryId=categories.FirstOrDefault(c=>c.Active&&c.Kind==MovementKind.Expense)?.Id,AccountId=accounts.FirstOrDefault(a=>a.Account.Active)?.Account.Id};message=null;}
    void EditorKindChanged(){if(editor is not null){editor.CategoryId=null;editor.DestinationAccountId=null;}}
    async Task Edit(MovementRow row)=>await Run(async()=>editor=await Service.MovementForRowAsync(row));
    async Task Save()=>await Run(async()=>{var savedDate=editor!.Date;var savedId=await Service.SaveMovementAsync(editor);editor=null;years=years.Append(savedDate.Year).Distinct().OrderDescending().ToList();await Load(CopyFilter(appliedFilter));message=savedDate<appliedFilter.From||savedDate>appliedFilter.To?"Movimento guardado fora do período apresentado. Altera o período para o consultar.":"Movimento guardado.";var warning=await Service.MovementOriginWarningAsync(savedId);if(warning is not null)message+=" "+warning;});
    async Task ConfirmVoid()=>await Run(async()=>{var paymentId=pendingVoid!.Id;await Service.VoidRowAsync(pendingVoid,Guid.NewGuid());pendingVoid=null;await Load(CopyFilter(appliedFilter));message="Movimento anulado. O histórico foi preservado.";var warning=await Service.MovementOriginWarningAsync(paymentId);if(warning is not null)message+=" "+warning;});
    async Task Previous()=>await Run(async()=>{var requested=CopyFilter(appliedFilter);requested.Page--;await Load(requested);});
    async Task Next()=>await Run(async()=>{var requested=CopyFilter(appliedFilter);requested.Page++;await Load(requested);});
    async Task Run(Func<Task> action){if(busy||disposed)return;busy=true;StateHasChanged();await Task.Delay(1);error=false;message=null;try{await action();}catch(FinanceRuleException e){message=e.Message;error=true;}catch(Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException){message="Os dados foram alterados. Atualiza e volta a abrir o registo.";error=true;}finally{busy=false;if(filtersPending&&!disposed){filtersPending=false;await Apply();}}}
    public void Dispose(){disposed=true;CancelSearch();}
}
