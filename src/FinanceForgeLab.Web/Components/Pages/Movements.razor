@page "/movimentos"
@inject FinanceService Service
<PageTitle>Movimentos · FinanceForgeLab</PageTitle>
<div class="page-heading"><div><span class="eyebrow">CADA REGISTO CONTA</span><h1>Movimentos</h1><p>Consulta o histórico e organiza as entradas e saídas.</p></div><div class="heading-actions"><a class="button" href="@ExportUrl" download>↓ Exportar CSV</a><button class="button primary" @onclick="New">+ Novo movimento</button></div></div>
@if(message is not null){<div role="status" class="notice @(error?"error":"success")">@message</div>}
<section class="panel filter-panel"><div class="filter-grid"><label class="search-field">Pesquisar<input placeholder="Descrição ou observações…" @bind="filter.Search" @bind:event="oninput"/></label><label>Desde<input type="date" @bind="filter.From"/></label><label>Até<input type="date" @bind="filter.To"/></label><label>Conta<select @bind="filter.AccountId"><option value="">Todas as contas</option><option value="-1">Por associar</option>@foreach(var a in accounts){<option value="@a.Account.Id">@a.Account.Name</option>}</select></label><label>Categoria<select @bind="filter.CategoryId"><option value="">Todas as categorias</option>@foreach(var c in categories){<option value="@c.Id">@CategoryName(c)</option>}</select></label><label>Tipo<select @bind="filter.Kind"><option value="">Todos</option><option value="@MovementKind.Income">Receitas</option><option value="@MovementKind.Expense">Despesas</option><option value="@MovementKind.Transfer">Transferências</option></select></label><label>Pessoa<select @bind="filter.PersonId"><option value="">Todas</option>@foreach(var p in people){<option value="@p.Id">@p.Name</option>}</select></label><div class="filter-actions"><label class="checkbox-label"><input type="checkbox" @bind="filter.IncludeVoided"/> Incluir anulados</label><button class="button primary" @onclick="Apply" disabled="@busy">Pesquisar</button><button class="button ghost" @onclick="Clear">Limpar</button></div></div></section>
@if(pendingVoid is not null){<div class="notice warning"><div><strong>Anular este movimento?</strong><p>O registo mantém-se no histórico. Uma transferência será anulada nas duas contas.</p></div><button class="button danger" @onclick="ConfirmVoid" disabled="@busy">Confirmar anulação</button><button class="button" @onclick="()=>pendingVoid=null">Cancelar</button></div>}
@if(editor is { } form){<section class="panel editor-panel"><div class="panel-heading"><div><h2>@(form.Id==0?"Novo movimento":"Editar movimento")</h2><p>Os valores negativos representam estornos ou correções.</p></div><button type="button" class="icon-button" aria-label="Fechar formulário" @onclick="()=>editor=null">×</button></div>
@if(accounts.Count==0&&form.Id==0){<div class="notice"><p>Adiciona a tua primeira conta para registar movimentos novos.</p><a href="/contas">Adicionar conta →</a></div>}
<EditForm Model="form" OnValidSubmit="Save" FormName="movement"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid"><label>Tipo<InputSelect @bind-Value="form.Kind"><option value="@MovementKind.Income">Receita</option><option value="@MovementKind.Expense">Despesa</option><option value="@MovementKind.Transfer">Transferência</option></InputSelect></label><label>Data<InputDate @bind-Value="form.Date"/></label><label>Montante em EUR<InputNumber @bind-Value="form.Amount" step="0.0001"/></label><label>Conta de origem<InputSelect @bind-Value="form.AccountId"><option value="">Por associar (histórico)</option>@foreach(var a in accounts){<option value="@a.Account.Id">@a.Account.Name @(a.Account.Active?"":"(inativa)")</option>}</InputSelect></label>
@if(form.Kind==MovementKind.Transfer){<label>Conta de destino<InputSelect @bind-Value="form.DestinationAccountId"><option value="">Selecionar conta</option>@foreach(var a in accounts){<option value="@a.Account.Id">@a.Account.Name</option>}</InputSelect></label>}else{<label>Categoria<InputSelect @bind-Value="form.CategoryId"><option value="">Selecionar categoria</option>@foreach(var c in categories.Where(c=>c.Kind==form.Kind&&(c.Active||c.Id==form.CategoryId))){<option value="@c.Id">@CategoryName(c)</option>}</InputSelect></label>}
<label>Pessoa<InputSelect @bind-Value="form.PersonId"><option value="">Sem pessoa associada</option>@foreach(var p in people){<option value="@p.Id">@p.Name</option>}</InputSelect></label><label class="span-2">Descrição<InputText @bind-Value="form.Description"/></label><label class="span-2">Observações<InputTextArea @bind-Value="form.Notes" rows="2"/></label></div><div class="form-footer"><span class="hint">Até quatro casas decimais. Sem arredondamento automático.</span><button type="button" class="button" @onclick="()=>editor=null">Cancelar</button><button class="button primary" type="submit" disabled="@busy">@(busy?"A guardar…":"Guardar movimento")</button></div></EditForm></section>}
<section class="panel"><div class="panel-heading"><div><h2>Registos financeiros</h2><p>@(page?.Total.ToString("N0")??"…") movimentos encontrados</p></div><span class="badge neutral">EUR</span></div><div class="table-wrap"><table><thead><tr><th>Data</th><th>Descrição / pessoa</th><th>Categoria</th><th>Conta</th><th>Tipo</th><th class="align-right">Montante</th><th><span class="sr-only">Ações</span></th></tr></thead><tbody>
@if(page is not null){foreach(var r in page.Rows){<tr class="@(r.Status=="Voided"?"voided":"")"><td class="date-cell">@r.Date.ToString("dd/MM/yyyy")</td><td><strong>@(string.IsNullOrWhiteSpace(r.Description)?"Sem descrição":r.Description)</strong><small>@(r.Person??"—") @(r.Origin=="Legacy"?" · Histórico":"")</small></td><td>@(r.ParentCategory??r.Category??"—")<small>@(r.ParentCategory is not null?r.Category:"")</small></td><td>@(r.Account??"Por associar")</td><td><span class="badge @(r.Status=="Voided"?"neutral":r.Kind==MovementKind.Income?"income":r.Kind==MovementKind.Expense?"expense":"neutral")">@(r.Status=="Voided"?"Anulado":Format.Kind(r.Kind))</span></td><td class="align-right amount @(r.Units>0?"positive":"")">@Format.Money(r.Units)</td><td class="row-actions">@if(r.Status=="Confirmed"&&r.Kind is MovementKind.Income or MovementKind.Expense or MovementKind.Transfer){<button title="Editar movimento" aria-label="Editar movimento" @onclick="()=>Edit(r.Id)">Editar</button><button class="danger-text" title="Anular movimento" @onclick="()=>pendingVoid=r">Anular</button>}</td></tr>}if(page.Rows.Count==0){<tr><td colspan="7" class="empty-small">Nenhum movimento corresponde a estes filtros.</td></tr>}}
</tbody></table></div><div class="pagination"><span>Página @(page?.Page??1) de @TotalPages</span><div><button class="button" disabled="@(busy||(page?.Page??1)<=1)" @onclick="Previous">← Anterior</button><button class="button" disabled="@(busy||(page?.Page??1)>=TotalPages)" @onclick="Next">Seguinte →</button></div></div></section>
@code{
    [SupplyParameterFromQuery(Name="novo")]public bool NewRequested{get;set;}
    [SupplyParameterFromQuery(Name="porAssociar")]public bool UnassignedRequested{get;set;}
    [SupplyParameterFromQuery(Name="conta")]public long? AccountRequested{get;set;}
    MovementFilter filter=new();MovementPage? page;MovementForm? editor;MovementRow? pendingVoid;List<AccountSummary> accounts=[];List<Category> categories=[];List<Person> people=[];string? message;bool error,busy;
    int TotalPages=>Math.Max(1,(int)Math.Ceiling((page?.Total??0)/(double)(page?.PageSize??40)));
    string CategoryName(Category c)=>(c.ParentId is null?"":categories.FirstOrDefault(p=>p.Id==c.ParentId)?.Name+" / ")+c.Name;
    string ExportUrl=>"/api/v1/export.csv?"+string.Join("&",new Dictionary<string,string?>{{"from",filter.From?.ToString("yyyy-MM-dd")},{"to",filter.To?.ToString("yyyy-MM-dd")},{"accountId",filter.AccountId?.ToString()},{"categoryId",filter.CategoryId?.ToString()},{"personId",filter.PersonId?.ToString()},{"kind",filter.Kind?.ToString()},{"search",filter.Search},{"includeVoided",filter.IncludeVoided.ToString()}}.Where(x=>!string.IsNullOrEmpty(x.Value)).Select(x=>x.Key+"="+Uri.EscapeDataString(x.Value!)));
    protected override async Task OnInitializedAsync(){accounts=await Service.AccountsAsync();categories=await Service.CategoriesAsync();people=await Service.PeopleAsync();filter.AccountId=UnassignedRequested?-1:AccountRequested;await Load();if(NewRequested)New();}
    async Task Load(){page=await Service.MovementsAsync(filter);filter.Page=page.Page;}
    async Task Apply(){filter.Page=1;await Run(Load);}
    async Task Clear(){filter=new();await Run(Load);}
    void New(){editor=new(){CategoryId=categories.FirstOrDefault(c=>c.Active&&c.Kind==MovementKind.Expense)?.Id,AccountId=accounts.FirstOrDefault(a=>a.Account.Active)?.Account.Id};message=null;}
    async Task Edit(long id)=>await Run(async()=>editor=await Service.MovementAsync(id));
    async Task Save()=>await Run(async()=>{await Service.SaveMovementAsync(editor!);editor=null;await Load();message="Movimento guardado.";});
    async Task ConfirmVoid()=>await Run(async()=>{await Service.VoidMovementAsync(pendingVoid!.Id,pendingVoid.Version,Guid.NewGuid());pendingVoid=null;await Load();message="Movimento anulado. O histórico foi preservado.";});
    async Task Previous(){filter.Page--;await Run(Load);}async Task Next(){filter.Page++;await Run(Load);}
    async Task Run(Func<Task> action){if(busy)return;busy=true;error=false;message=null;try{await action();}catch(FinanceRuleException e){message=e.Message;error=true;}catch(Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException){message="Os dados foram alterados. Atualiza e volta a abrir o registo.";error=true;}finally{busy=false;}}
}
